# API
# NODE_ENV=production zmienia wartości domyślne: HOST=0.0.0.0 i OPS_ENABLED=false.
# NODE_ENV=production
PORT=3001
# Domyślnie 127.0.0.1, a przy NODE_ENV=production 0.0.0.0 (serwer, kontener).
# HOST=127.0.0.1
DATABASE_PATH=data/pas.sqlite

# Czas trzymania miejsca. Domyślnie 15 minut.
# Tryb testowy prowadzącego: RESERVATION_TTL_MINUTES=2 i BEZ RESERVATION_TTL_SECONDS.
RESERVATION_TTL_MINUTES=15
# Nadpisanie w sekundach — wyłącznie do testów i demo (np. 20).
# Ma pierwszeństwo przed MINUTES; gdy ustawisz obie, API ostrzega w logu startowym.
# RESERVATION_TTL_SECONDS=20

# Zależność zewnętrzna: dostawca e-mail (mock w apps/mock-mail)
MAIL_PROVIDER_URL=http://127.0.0.1:3002/send
MAIL_CONTROL_URL=http://127.0.0.1:3002
MAIL_TIMEOUT_MS=1200
MAIL_RETRY_ATTEMPTS=2
MAIL_RETRY_BASE_DELAY_MS=250
MAIL_BREAKER_FAILURE_THRESHOLD=4
MAIL_BREAKER_RESET_MS=15000

# Kolejka i worker
WORKER_ENABLED=true
WORKER_INTERVAL_MS=250
WORKER_MAX_ATTEMPTS=5
WORKER_LEASE_MS=30000
WORKER_BASE_BACKOFF_MS=2000
WORKER_MAX_BACKOFF_MS=60000

# Ochrona przed przeciążeniem (E05)
RATE_LIMIT_ENABLED=true
# Limit rezerwacji per IP (token bucket). Odmowy walidacji (400/413/415) oddają żeton, 404 i 409 nie.
RATE_LIMIT_RESERVATION_CAPACITY=60
RATE_LIMIT_RESERVATION_REFILL_PER_SECOND=2
LOAD_SHED_MAX_IN_FLIGHT=80
LOAD_SHED_RETRY_AFTER=5
READ_BULKHEAD_CONCURRENCY=32
READ_BULKHEAD_QUEUE=100
WRITE_BULKHEAD_CONCURRENCY=8
WRITE_BULKHEAD_QUEUE=40
BULKHEAD_WAIT_MS=1000

# Za reverse proxy (nginx, Render, Railway, Cloudflare) ustaw LICZBĘ proxy przed API, np. 1.
# Bez tego limit widzi IP proxy i blokuje wszystkich klientów naraz.
# Nie używaj `true`: wtedy klient podrabia X-Forwarded-For i obchodzi limit.
TRUST_PROXY=false

# Panel /lab (E04–E06). Domyślnie włączony lokalnie, wyłączony przy NODE_ENV=production.
# OPS_ENABLED=true
# Gdy ustawiony, /api/ops/* wymaga nagłówka `Authorization: Bearer <token>`.
# Uwaga: /lab w przeglądarce nie wysyła tokenu, więc z tokenem pokaże błąd połączenia.
# OPS_TOKEN=

# Zbudowany frontend (apps/web/dist) serwowany przez API pod tym samym adresem.
# Włączone automatycznie, gdy istnieje apps/web/dist/index.html.
# SERVE_WEB=true
# WEB_DIST_PATH=../web/dist

# Mock dostawcy e-mail (apps/mock-mail)
MOCK_MAIL_PORT=3002
MOCK_MAIL_HOST=127.0.0.1
