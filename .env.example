# API
# NODE_ENV=production zmienia wartości domyślne: HOST=0.0.0.0 i OPS_ENABLED=false.
# NODE_ENV=production
PORT=3001
# Domyślnie 127.0.0.1, a przy NODE_ENV=production 0.0.0.0 (serwer, kontener).
# HOST=127.0.0.1
DATABASE_PATH=data/pas.sqlite

# Czas trzymania miejsca. Domyślnie 15 minut.
# Tryb testowy prowadzącego: RESERVATION_TTL_MINUTES=2 i BEZ RESERVATION_TTL_SECONDS.
RESERVATION_TTL_MINUTES=15
# Nadpisanie w sekundach — wyłącznie do testów i demo (np. 20).
# Ma pierwszeństwo przed MINUTES; gdy ustawisz obie, API ostrzega w logu startowym.
# RESERVATION_TTL_SECONDS=20

# Zależność zewnętrzna: dostawca e-mail (mock w apps/mock-mail)
MAIL_PROVIDER_URL=http://127.0.0.1:3002/send
MAIL_CONTROL_URL=http://127.0.0.1:3002
MAIL_TIMEOUT_MS=1200
MAIL_RETRY_ATTEMPTS=2
MAIL_RETRY_BASE_DELAY_MS=250
MAIL_BREAKER_FAILURE_THRESHOLD=4
MAIL_BREAKER_RESET_MS=15000

# Płatności — Stripe Checkout (Etap II). WYŁĄCZNIE klucze testowe.
# Bez obu zmiennych checkout i webhook odpowiadają 503 PAYMENTS_UNAVAILABLE.
# Klucz live (sk_live_…) wyłącza płatności. Klucze trzymaj tylko w .env / zmiennych platformy.
# STRIPE_SECRET_KEY=sk_test_...
# Lokalnie: sekret z `stripe listen`; na serwerze: sekret endpointu z panelu Stripe (tryb testowy).
# STRIPE_WEBHOOK_SECRET=whsec_...
# Adres sklepu, na który Stripe odsyła klienta po płatności (success_url / cancel_url).
PUBLIC_URL=http://localhost:5173
STRIPE_TIMEOUT_MS=8000
STRIPE_MAX_NETWORK_RETRIES=2
STRIPE_BREAKER_FAILURE_THRESHOLD=5
STRIPE_BREAKER_RESET_MS=30000

# Program lojalnościowy — Voucherify (Etap III). WYŁĄCZNIE projekt Sandbox.
# Voucherify jest źródłem prawdy o saldzie; baza pamięta tylko e-mail → karta.
# Klucze znajdziesz w panelu: Project settings → Application keys (para x-app-id / x-app-token).
# VOUCHERIFY_APP_ID=...
# VOUCHERIFY_APP_TOKEN=...
# Identyfikator kampanii lojalnościowej z panelu Voucherify (Campaigns → loyalty program).
# VOUCHERIFY_CAMPAIGN_ID=...
# Europejskie centrum danych: https://api.voucherify.io (US: https://api.us.voucherify.io).
# VOUCHERIFY_API_URL=https://api.voucherify.io
# `auto` (domyślnie) wybiera Voucherify, gdy są kompletne klucze; inaczej pamięć procesu.
# `memory` wymusza lokalny fallback do demo/testów (saldo znika po restarcie).
# LOYALTY_PROVIDER=auto
# LOYALTY_WELCOME_POINTS=1000
VOUCHERIFY_TIMEOUT_MS=5000
# Ponowienia tylko dla odczytów i zakładania karty; korekty salda nie ponawiamy (podwójne pobranie).
VOUCHERIFY_MAX_RETRIES=2
VOUCHERIFY_BREAKER_FAILURE_THRESHOLD=5
VOUCHERIFY_BREAKER_RESET_MS=30000
# Sandbox Voucherify przyjmuje NAJWYŻEJ 100 wywołań API na godzinę (cały projekt).
# Nasz budżet w oknie przesuwnym 1 h — z zapasem na ręczne wywołania w panelu/Postmanie.
# Przy kilku instancjach API podziel budżet między nie (licznik jest w pamięci procesu).
VOUCHERIFY_HOURLY_BUDGET=90
# Rezerwa tylko dla zwrotów punktów i naliczeń po zakupie (nie zużyją jej odczyty ani checkout).
VOUCHERIFY_RESERVE_CRITICAL=20
# Rezerwa dla checkoutu: odczyty salda kończą się przy BUDGET − CRITICAL − CHECKOUT (domyślnie 15),
# checkout przy BUDGET − CRITICAL (70). 55: pełny test prowadzącego z jednego IP mieści się
# w budżecie bez odmów. Koszty i przepustowość: CONTRACT.md §11.6.1.
VOUCHERIFY_RESERVE_CHECKOUT=55
# Cache salda w pamięci procesu — tylko optymalizacja odczytu, prawdą jest Voucherify
# (saldo może zmienić się poza nami, np. korekta w panelu), więc TTL jest krótki. 0 = bez cache.
# 10 s: zmiana w panelu widoczna w sklepie najpóźniej po 10 s (obietnica: 15 s).
# Checkout nigdy nie używa tego cache — przed pobraniem punktów czyta saldo świeżo.
LOYALTY_BALANCE_CACHE_SECONDS=10
# E-mail bez karty w naszej bazie: domyślnie GET /api/loyalty odpowiada 1000 bez wywołania
# Voucherify (tak mówi zadanie; każde wyszukanie zjadałoby limit 100/h przy wielu adresach
# delivered+…@resend.dev). true = raz szukaj karty założonej w panelu/kasie (koszt: 1 odczyt).
LOYALTY_LOOKUP_UNKNOWN_CARDS=false
# Tylko z LOOKUP=true: wynik „brak karty” pamiętamy tyle sekund. Dłużej = mniej wywołań, ale karta założona
# w panelu dla adresu, o który ktoś właśnie pytał, pokaże się później. 0 = bez pamięci.
LOYALTY_NO_CARD_CACHE_SECONDS=10
# Gdy Voucherify nie odpowiada albo budżet się skończył, samo WYŚWIETLENIE salda może użyć
# odczytu nie starszego niż tyle sekund (checkout nigdy nie używa starego salda). 0 = 503 od razu.
LOYALTY_BALANCE_STALE_SECONDS=600

# Maile — Resend (Etap III). Bez klucza maile idą do lokalnego mocka (MAIL_PROVIDER_URL).
# Domena nadawcy musi być zweryfikowana w Resend; w Sandboxie działa onboarding@resend.dev.
# Bez domeny Resend wysyła TYLKO na adres właściciela konta oraz delivered@resend.dev /
# bounced@resend.dev; inne adresy dostają 403 (błąd trwały → DLQ, punkty i tak są naliczane).
# RESEND_API_KEY=re_...
# RESEND_FROM=PAS Kasa <onboarding@resend.dev>
# RESEND_API_URL=https://api.resend.com
RESEND_TIMEOUT_MS=5000

# Kolejka i worker
WORKER_ENABLED=true
WORKER_INTERVAL_MS=250
WORKER_MAX_ATTEMPTS=5
WORKER_LEASE_MS=30000
WORKER_BASE_BACKOFF_MS=2000
WORKER_MAX_BACKOFF_MS=60000
# Voucherify niedostępny (awaria, limit) przy naliczeniu albo zaległym zwrocie punktów: job czeka
# na Voucherify bez zużywania prób, z odstępem rosnącym od BASE do MAX. Po HORIZON godzin od
# utworzenia joba — zwykłe próby (WORKER_MAX_ATTEMPTS) i DLQ w /lab. Mail nie idzie drugi raz.
WORKER_LOYALTY_RETRY_BASE_MS=5000
WORKER_LOYALTY_RETRY_MAX_MS=60000
WORKER_LOYALTY_RETRY_HORIZON_HOURS=24

# Zwrot punktów porzuconych sesji: co tyle ms sesje z punktami, których rezerwacja wygasła,
# są wygaszane w Stripe, a punkty wracają na kartę (≤ 15 s po expiresAt).
POINTS_SWEEP_ENABLED=true
POINTS_SWEEP_INTERVAL_MS=2000
POINTS_SWEEP_BATCH=20

# Ochrona przed przeciążeniem (E05)
RATE_LIMIT_ENABLED=true
# Limit rezerwacji per IP (token bucket). Odmowy walidacji (400/413/415) oddają żeton, 404 i 409 nie.
RATE_LIMIT_RESERVATION_CAPACITY=40
RATE_LIMIT_RESERVATION_REFILL_PER_SECOND=4
# Odczyt salda punktów (GET /api/loyalty) per IP: pojemność i dolewanie na minutę.
# Chroni godzinny limit Voucherify przed skryptem; zły e-mail (400) oddaje żeton.
# 30/20: prowadzący sprawdza saldo z jednego laptopa (przy 429 pole „Użyj punktów” znika).
RATE_LIMIT_LOYALTY_CAPACITY=30
RATE_LIMIT_LOYALTY_PER_MINUTE=20
# Checkout Z PUNKTAMI, który doszedł do Voucherify (1–4 wywołania), per IP i per e-mail rezerwacji.
# Walidacja, 404/409 i powtórka tej samej sesji nie zużywają żetonu; 503 go oddaje. 429 RATE_LIMITED.
RATE_LIMIT_POINTS_IP_CAPACITY=30
RATE_LIMIT_POINTS_IP_PER_HOUR=6
RATE_LIMIT_POINTS_EMAIL_CAPACITY=6
RATE_LIMIT_POINTS_EMAIL_PER_HOUR=6
LOAD_SHED_MAX_IN_FLIGHT=80
LOAD_SHED_RETRY_AFTER=5
# Czas na nagłówki i limit bezczynności połączenia (ms) — rozłącza klienta, który nie kończy body.
REQUEST_TIMEOUT_MS=10000
READ_BULKHEAD_CONCURRENCY=32
READ_BULKHEAD_QUEUE=100
WRITE_BULKHEAD_CONCURRENCY=8
WRITE_BULKHEAD_QUEUE=40
BULKHEAD_WAIT_MS=1000

# Za reverse proxy (nginx, Render, Railway, Cloudflare) ustaw LICZBĘ proxy przed API, np. 1.
# Bez tego limit widzi IP proxy i blokuje wszystkich klientów naraz.
# Nie używaj `true`: wtedy klient podrabia X-Forwarded-For i obchodzi limit.
TRUST_PROXY=false

# Panel /lab (E04–E06). Domyślnie włączony lokalnie, wyłączony przy NODE_ENV=production.
# OPS_ENABLED=true
# Gdy ustawiony, /api/ops/* wymaga nagłówka `Authorization: Bearer <token>`.
# Uwaga: /lab w przeglądarce nie wysyła tokenu, więc z tokenem pokaże błąd połączenia.
# OPS_TOKEN=

# Zbudowany frontend (apps/web/dist) serwowany przez API pod tym samym adresem.
# Włączone automatycznie, gdy istnieje apps/web/dist/index.html.
# SERVE_WEB=true
# WEB_DIST_PATH=../web/dist

# Mock dostawcy e-mail (apps/mock-mail)
MOCK_MAIL_PORT=3002
MOCK_MAIL_HOST=127.0.0.1
